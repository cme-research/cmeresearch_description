<?xml version="1.0"?>
<!-- Basic mecanum drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanumdrive_robot">
  <!-- Parameters -->
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="prefix" default="" />


  <!-- Import robot description -->
  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexa/robot_description.urdf.xacro" />

  <!-- Robot constants and properties -->

  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexa/robot_properties.urdf.xacro" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find cmeresearch_description)/urdf/materials.xacro" />

  <!-- Import ros2_control description -->
  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexa/robot_mecanum.ros2_control.xacro" />

  <!-- Instantiate the robot -->
  <xacro:cmexa prefix="$(arg prefix)" />

  <!-- Add ros2_control -->
  <xacro:cmexa_ros2_control
    name="Cmexa" use_mock_hardware="$(arg use_mock_hardware)" prefix="$(arg prefix)"/>

</robot>
