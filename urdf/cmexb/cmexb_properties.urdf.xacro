<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- wheelbase = distance between wheel axis (x-direction)
       example: distance between wheel_front_right and wheel_rear_right-->
  <xacro:property name="wheelbase" value="0.090" />
  <!-- track = distance between wheels (y-direction)
       example: distance between wheel_front_right and wheel_front_left -->
  <xacro:property name="track" value="0.112" />
  <!-- vertical offset means height -->
  <xacro:property name="wheel_vertical_offset" value="0.044" />
  <xacro:property name="footprint_vertical_offset" value="0.025" />

  <xacro:property name="wheel_radius" value="0.035" />
  <xacro:property name="wheel_width" value="0.015" />
  <xacro:property name="gear_ratio" value="5.0"/>

  <xacro:property name="chassis_length" value="0.200" />
  <xacro:property name="chassis_width" value="0.130" />
  <xacro:property name="chassis_height" value="0.150" />
  <xacro:property name="chassis_mass" value="0.3" />

  <xacro:property name="dummy_inertia" value="1e-09"/>

  <xacro:property name="mount_spacing" value="0.120" />

  <xacro:property name="z_offset" value="-${chassis_height/2}" /> <!-- Space btw top of beam and the each joint -->
  <xacro:property name="wheel_mass" value="0.1"/>

</robot>
