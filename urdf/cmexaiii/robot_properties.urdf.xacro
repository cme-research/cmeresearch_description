<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- wheelbase = distance between wheel axis (x-direction)
       example: distance between wheel_front_right and wheel_rear_right-->
  <xacro:property name="wheelbase" value="0.300" />
  <!-- track = distance between wheels (y-direction)
       example: distance between wheel_front_right and wheel_front_left -->
  <xacro:property name="track" value="0.354" />
  <xacro:property name="gear_ratio" value="5.0" />
  <xacro:property name="steps_per_revolution" value="200.0" />
  <!-- Bricklet microstep mode: must match SILENT_STEPPER_V2_STEP_RESOLUTION_*
       configured in cmeresearch_stepper_driver. 8 = 1/8 step (8 microsteps per full step). -->
  <xacro:property name="step_resolution" value="8" />
  <!-- Per-wheel velocity ceiling in microsteps/s on the motor shaft. MUST match
       the max_step_vel passed to cmeresearch_stepper_driver (see
       cmexaiii_hardware.launch.py, currently 8000). cmexa_base uses this to
       proportionally normalize the four mecanum wheel commands so combined
       translation/rotation never over-drives two wheels while preserving the
       commanded motion direction. -->
  <xacro:property name="max_step_vel" value="8000" />
  <!-- vertical offset means height -->
  <xacro:property name="wheel_vertical_offset" value="0.01" />
  <xacro:property name="footprint_vertical_offset" value="0.025" />

  <xacro:property name="wheel_radius" value="0.050" />
  <xacro:property name="wheel_width" value="0.050" />

  <xacro:property name="chassis_length" value="1.100" />
  <xacro:property name="chassis_width" value="0.550" />
  <xacro:property name="chassis_height" value="0.950" />
  <xacro:property name="chassis_mass" value="20.0" /> <!-- correct this later -->

  <xacro:property name="dummy_inertia" value="1e-09"/>

  <xacro:property name="mount_spacing" value="0.120" />

</robot>
