<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- wheelbase = distance between wheel axis (x-direction)
       example: distance between wheel_front_right and wheel_rear_right-->
  <xacro:property name="wheelbase" value="0.170" />
  <!-- track = distance between wheels (y-direction)
       example: distance between wheel_front_right and wheel_front_left -->
  <xacro:property name="track" value="0.230" />
  <!-- vertical offset means height -->
  <xacro:property name="wheel_vertical_offset" value="0.044" />
  <xacro:property name="footprint_vertical_offset" value="-0.0655" />

  <xacro:property name="wheel_radius" value="0.041" /> <!-- 0.087-->
  <xacro:property name="wheel_width" value="0.040" />

  <xacro:property name="chassis_length" value="0.330" />
  <xacro:property name="chassis_width" value="0.180" />
  <xacro:property name="chassis_height" value="0.144" />

  <xacro:property name="dummy_inertia" value="1e-09"/>

  <xacro:property name="mount_spacing" value="0.120" />

</robot>
